{
  "#": "Defaults shipped with dic.  Do not edit: this file is replaced on upgrade.  Write ~/.config/fac/providers.json and ~/.config/fac/models.json (or point $DIC_MODELS at a file) instead; their entries are merged over these, key by key, so an id may be reused to change one setting.  Keys beginning with '#' are comments.",

  "#ids": "An id is a '+'-separated chain, weakest first: 'groq+qwen' is the entry 'qwen' layered on the entry 'groq'.  Entries with \"abstract\": true are providers or mixins; they cannot be used with -m, only inherited from.  Chains nobody wrote down work too: 'thinking-high+anthropic+sonnet'.",

  "groq": {
    "abstract": true,
    "api_base": "https://api.groq.com/openai/v1",
    "api_key_name": "GROQ_API_KEY"
  },

  "cerebras": {
    "abstract": true,
    "api_base": "https://api.cerebras.ai/v1",
    "api_key_name": "CEREBRAS_API_KEY"
  },

  "anthropic": {
    "abstract": true,
    "api_type": "anthropic-messages",
    "api_base": "https://api.anthropic.com/v1",
    "api_key_name": "ANTHROPIC_API_KEY"
  },

  "openai": {
    "abstract": true,
    "api_type": "openai-responses",
    "api_base": "https://api.openai.com/v1",
    "api_key_name": "OPENAI_API_KEY"
  },

  "openrouter": {
    "abstract": true,
    "api_base": "https://openrouter.ai/api/v1",
    "api_key_name": "OPENROUTER_API_KEY"
  },

  "thinking-high": {
    "abstract": true,
    "options": {"thinking": {"type": "enabled", "budget_tokens": 8000}}
  },

  "cerebras+qwen": {
    "model_name": "qwen-3.8-27b"
  },

  "groq+qwen": {
    "model_name": "qwen/qwen3.8-27b",
    "alias": "qwen",
    "options": {"max_tokens": 800}
  },

  "anthropic+fable":  {"model_name": "claude-fable-5-1",  "cost_input": 10.0,  "cost_output": 50.0},
  "anthropic+opus":   {"model_name": "claude-opus-5",     "cost_input":  5.0,  "cost_output": 25.0},
  "anthropic+sonnet": {"model_name": "claude-sonnet-5",   "cost_input":  2.0,  "cost_output": 10.0},
  "anthropic+haiku":  {"model_name": "claude-haiku-4-5",  "cost_input":  1.0,  "cost_output":  5.0},

  "openai+astra":     {"model_name": "gpt-6-astra",       "cost_input": 10.00, "cost_output": 50.00 },
  "openai+sol":       {"model_name": "gpt-5.6-sol",       "cost_input":  4.00, "cost_output": 20.00 },
  "openai+terra":     {"model_name": "gpt-5.6-terra",     "cost_input":  2.00, "cost_output": 12.00 },
  "openai+luna":      {"model_name": "gpt-5.6-luna",      "cost_input":  0.20, "cost_output":  1.20 },

  "openrouter+deepseek":     {"model_name": "deepseek/deepseek-v4.1-flash", "cost_input": 0.15, "cost_output": 0.60},
  "openrouter+gemini-flash": {"model_name": "google/gemini-3.8-flash",     "cost_input": 0.75, "cost_output": 0.75}
}
